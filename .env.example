# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI (Google Gemini). Optional: without it, calls get deterministic metrics only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment links (Stripe Payment Links or similar). Leave blank until provided.
NEXT_PUBLIC_PAYMENT_LINK_STARTER=
NEXT_PUBLIC_PAYMENT_LINK_GROWTH=
# Shared secret your payment automation sends as header x-webhook-secret
BILLING_WEBHOOK_SECRET=
